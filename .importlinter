# Every new domain package goes into core-is-independent's forbidden_modules and,
# for its handlers module, into handlers-skip-repositories' source_modules.
[importlinter]
root_packages =
    src
    loggers
    models
# Lets a contract name a third-party package (sqlalchemy below).
include_external_packages = True

[importlinter:contract:core-is-independent]
name = src.core does not import domain packages or the composition root
type = forbidden
source_modules =
    src.core
forbidden_modules =
    src.main
    src.user
    src.admin
    src.developer
    src.system
    src.broadcast
    src.note
    models

[importlinter:contract:handlers-skip-repositories]
name = Handlers reach data through use cases, never through repositories
type = forbidden
source_modules =
    src.user.handlers
    src.admin.handlers
    src.developer.handlers
    src.broadcast.handlers
    src.note.handlers
forbidden_modules =
    src.user.repositories
    src.core.llm.usage.repository
    src.broadcast.repositories
    src.note.repositories
    src.system.repositories
    src.core.outbox.repositories
    sqlalchemy
# Only direct imports count: a handler calls a use case, and the use case
# reaching repositories and SQLAlchemy is the point of having one.
allow_indirect_imports = True
