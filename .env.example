PROJECT_NAME="Telegram bot template"
VERSION=0.0.0
# COMMIT_SHA comes from the image build (make and CI pass it); leave it out
# here, or this file would override the commit baked into the image.
# DEBUG=true also disables Sentry (src/main/sentry.py); keep it false in production.
DEBUG=false
TESTING=false

# Possible logging levels: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO
# Emit one JSON object per log line (timestamp, level, logger, message,
# update_id, user_id, process) instead of the plain-text formats. Turn on for
# log aggregators that parse structured stdout; leave off for local readability.
LOG_JSON=false

# Bot
# The token @BotFather issued. Replace the placeholder: startup refuses a value
# that does not look like a real token.
BOT_TOKEN=replace-with-the-token-from-BotFather
# polling needs nothing but outbound access to Telegram, which suits local
# development; webhook needs a public HTTPS URL (see the webhook block below).
BOT_MODE=polling
# Language for users whose Telegram client reports none, or one we do not
# translate. Must be one of the locales under locales/.
DEFAULT_LOCALE=en
# A user row is rewritten when the Telegram profile changes, or when last_seen_at
# is older than this many seconds; every other update reads it and moves on.
USER_TOUCH_INTERVAL_SECONDS=300
# How long a user's cached snapshot answers updates without the database. The
# bot drops it at once on a language change, a ban and a reachability change;
# a row edited by hand in the database shows up after at most this many seconds.
# Must not exceed CACHE_VERSION_TTL.
USER_CACHE_TTL_SECONDS=300
# Flood-wait retries per Bot API call, 0 to 10. Each retry sleeps for as long as
# Telegram asked, up to 30 seconds of sleep for all calls of one update together.
TELEGRAM_RETRY_ATTEMPTS=3
# How long a stopping bot waits for updates already being handled. Keep it below
# the container's stop_grace_period, or Docker kills the process first.
SHUTDOWN_TIMEOUT_SECONDS=20

# Telegram user ids, comma-separated, e.g. ADMIN_IDS=123456789,987654321.
# Admins get /stats, /ban, /unban, /broadcast and the new-user notice;
# developers get /status, /test_alert and the error alerts. A wrong id grants
# the role to nobody (or to a stranger); a group id is rejected at startup.
ADMIN_IDS=
DEVELOPER_IDS=
# Developer alerts (unexpected errors, failed tasks, Redis outages). A group or
# channel id here gets every alert; empty sends them to each DEVELOPER_IDS
# member in private. The bot must be a member of that chat, or alerts are lost
# (and only logged).
DEV_ALERT_CHAT_ID=
# The same failure (type, place, origin) is alerted once per this many seconds.
# Too low floods the alert chat while an incident lasts; too high hides a new
# failure of the same type in the same place behind the first alert.
ALERT_COOLDOWN_SECONDS=300
# Message every admin (ADMIN_IDS) who has opened the bot when a user starts it
# for the first time, in the admin's own language. false keeps the notice task
# running but sends nothing.
NOTIFY_ADMINS_ON_NEW_USER=true

# Web server
# Serves the health endpoints in both modes and the Telegram webhook in webhook
# mode. Inside the container it listens on every interface; compose keeps the
# port on the internal network.
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Webhook
# Used only when BOT_MODE=webhook, which then refuses to start without
# WEBHOOK_BASE_URL and WEBHOOK_SECRET. The base URL is the public origin
# Telegram will call, https only (Telegram does not call plain http).
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
# Telegram echoes this in a header on every update and the bot rejects a request
# without it, so nobody else can feed the endpoint. 32-256 characters of
# A-Z a-z 0-9 _ -. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=
# Simultaneous connections Telegram may open to the webhook, 1 to 100.
WEBHOOK_MAX_CONNECTIONS=40

# SQL Database
DB_ECHO=0
POSTGRES_USER=admin
POSTGRES_PASSWORD=example-postgres-password-not-real
# Inside the compose stack the hosts are the service names; use localhost to run the
# bot on the host against the stack's published ports.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host side of the 127.0.0.1 bind in infra/docker-compose.yml, default 5432.
# Change it only when that port is taken on the host; POSTGRES_PORT stays 5432.
# POSTGRES_HOST_PORT=5432
POSTGRES_DB=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
# Server-side limits per connection, in seconds; 0 turns one off. A single
# transaction may raise its own statement cap (set_local_statement_timeout).
DB_STATEMENT_TIMEOUT_SECONDS=30
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=example-redis-password-not-real
REDIS_PORT=6379
# Host side of the 127.0.0.1 bind in infra/docker-compose.yml, default 6379.
# REDIS_HOST_PORT=6379
REDIS_DATABASE=0
# FSM state lives in its own database so a FLUSHDB on the cache never drops a
# user in the middle of a dialog.
REDIS_FSM_DATABASE=2
# Database index of the task queue (taskiq streams, retry schedules, the
# scheduler heartbeat). Must differ from REDIS_DATABASE and REDIS_FSM_DATABASE:
# flushing the cache database by hand would otherwise drop queued tasks too.
# The three indexes are integers from 0 and must differ, compared as numbers
# (01 is 1); the bot, worker and scheduler refuse to start otherwise.
REDIS_TASKS_DATABASE=1

# Cache (Redis database REDIS_DATABASE). CACHE_ENABLED=false makes every read
# a miss; nothing breaks, the database takes every read instead.
CACHE_ENABLED=true
# Seconds a value lives unless the caller sets its own TTL.
CACHE_DEFAULT_TTL=60
# Seconds a namespace's version counter lives; no TTL may exceed it.
CACHE_VERSION_TTL=604800
# Prefix of every cache key; change it when two bots share one Redis database.
CACHE_KEY_PREFIX=cache

# Sentry (empty DSN disables it)
SENTRY_DSN=https://example-key-not-real@your-org.ingest.sentry.io/your-project-id
SENTRY_ENV=development
SENTRY_ENABLED=false

# HTTP client for third-party APIs. Blank sends "<project-name>/<VERSION>";
# some APIs refuse a request without a recognisable agent.
HTTP_USER_AGENT=

# File storage (S3 or any S3-compatible service). Off by default: every call
# to the S3 client then fails with S3Disabled, and nothing else needs these keys.
# On, the bot refuses to start without the bucket, both keys and the region.
S3_ENABLED=false
# The bucket every call uses unless it names another. Must exist and be reachable
# with the keys below: a wrong name fails each request with NoSuchBucket.
S3_BUCKET_NAME=bucket-name
S3_ACCESS_KEY_ID=example-s3-access-key-id-not-real
S3_SECRET_ACCESS_KEY=example-s3-secret-access-key-not-real
# Region the bucket lives in. A wrong one makes AWS answer with a redirect or a
# signature error; S3-compatible services usually accept any value.
S3_REGION_NAME=eu-north-1
# Lifetime of a presigned URL unless the caller passes its own.
S3_PRE_SIGNED_URL_SECONDS=300
# Blank for AWS. Set for MinIO, R2 and the like; an endpoint switches the
# addressing style to "path" unless S3_ADDRESSING_STYLE says otherwise.
S3_ENDPOINT_URL=
# auto, path or virtual; blank picks for you.
S3_ADDRESSING_STYLE=
# Request signing scheme. Leave s3v4; an older one is refused by most services
# and by every newer AWS region.
S3_SIGNATURE_VERSION=s3v4
# false or a CA bundle path only for a self-hosted endpoint with its own CA;
# false against AWS lets anyone on the path read the keys and the files.
S3_VERIFY_SSL=true
# Path to a CA bundle file for S3_ENDPOINT_URL's certificate; blank uses the
# system store. A wrong path fails every request with an SSL error.
S3_CA_BUNDLE=
# true when the credentials may not list or read missing keys: head_object
# then reports a 403 as "no such object" instead of raising.
S3_TREAT_ACCESS_DENIED_AS_MISSING=false
# Seconds to open a connection. Too low fails on a slow network, too high holds
# the caller while an endpoint is down.
S3_CONNECT_TIMEOUT_SECONDS=5
# Seconds to wait for data on an open connection. With the retries below one
# call can take minutes, longer than the 60 s event-isolation lock and
# SHUTDOWN_TIMEOUT_SECONDS: move large transfers to a background task instead of
# a handler.
S3_READ_TIMEOUT_SECONDS=120
# Total attempts per request, the first one included in standard and adaptive
# modes: 3 means one try and two retries. 1 turns retries off.
S3_RETRY_MAX_ATTEMPTS=3
# botocore retry mode: legacy, standard or adaptive; anything else stops startup.
S3_RETRY_MODE=standard
# Largest stream upload_stream accepts; 20 MiB is what the Bot API lets a bot
# download. Over it the upload fails with S3ObjectTooLarge and stores nothing.
S3_MAX_UPLOAD_SIZE_BYTES=20971520

# Outgoing email over SMTP, sent by the worker (tasks email.send and
# email.send_with_s3_attachments). Off by default: the mailer refuses every
# send and EmailService refuses to queue one. On, the bot refuses to start
# without the server, the user and the sender name.
EMAIL_ENABLED=false
EMAIL_SERVER=smtp.example.com
# Port 587 upgrades the connection (EMAIL_STARTTLS=true), port 465 is TLS from
# the first byte (EMAIL_USE_TLS=true). Both true fails startup; both false
# sends in plain text, for a local catcher only.
EMAIL_PORT=587
EMAIL_USE_TLS=false
EMAIL_STARTTLS=true
# The login and the From address.
EMAIL_USER=bot@example.com
# Empty skips authentication (a local catcher such as Mailpit); a real server
# then refuses the mail.
EMAIL_PASSWORD=example-email-password-not-real
# Display name in From and in the footer of every template.
EMAIL_FROM_NAME=Example Bot
# false only for a local catcher with a self-signed certificate; against a real
# server it lets anyone on the path read the password and the mail.
EMAIL_VALIDATE_CERTS=true

# Throttling: how many handler calls one user gets per window. Over the limit
# the bot warns once and drops the rest until the window ends; too low and
# ordinary users hit it while tapping through menus. Admins and developers are
# never limited. "llm" applies to handlers that call a paid model.
THROTTLE_DEFAULT_LIMIT=20
THROTTLE_DEFAULT_WINDOW_SECONDS=60
THROTTLE_LLM_LIMIT=5
THROTTLE_LLM_WINDOW_SECONDS=60

# Broadcast: copies per second (Telegram allows about 30 to different users)
# and recipients per checkpoint. After a worker restart up to
# BROADCAST_CHECKPOINT_EVERY users may get the message twice.
BROADCAST_RATE_PER_SECOND=25
BROADCAST_CHECKPOINT_EVERY=50

# LLM (src/core/llm). An empty LLM_PROVIDER turns the layer off: the bot starts
# without any key and every LLM feature answers "not available". anthropic or
# openrouter; the bot then refuses to start without that provider's key.
LLM_PROVIDER=anthropic
# Anthropic ids as they are (claude-sonnet-5-5); OpenRouter ids are
# "<vendor>/<model>". An Anthropic model missing from src/core/llm/pricing.py
# and LLM_PRICING_OVERRIDES is recorded without a cost.
LLM_MODEL=claude-sonnet-5-5
# Takes over when the primary is unavailable, times out or is rate limited, and
# sends a developer alert. It must be another provider, so that one provider's
# outage cannot stop both. Empty LLM_FALLBACK_PROVIDER: no fallback.
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=google/gemini-3.8-flash
# Calls with these placeholders fail at the provider until real keys are set.
ANTHROPIC_API_KEY=sk-ant-example-key-not-real
OPENROUTER_API_KEY=sk-or-example-key-not-real
# Optional: OpenRouter credits the calls to this public URL and app name
# (HTTP-Referer and X-Title headers). Printable ASCII; blank sends neither.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
# Seconds per attempt, and retries after a 429, a 5xx or a network error. A user
# waits up to timeout x (retries + 1) for one provider before the fallback runs.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Prices that replace or extend src/core/llm/pricing.py, US dollars per million
# tokens, as JSON in single quotes. Each entry needs all four rates; malformed
# JSON, or a missing, unknown or negative rate, stops startup.
# LLM_PRICING_OVERRIDES='{"claude-opus-5-5": {"input_per_mtok": "4", "output_per_mtok": "20", "cache_write_per_mtok": "5", "cache_read_per_mtok": "0.40"}}'
LLM_PRICING_OVERRIDES=
# Days of llm_usage rows the daily purge keeps; at least 30, the longest
# period /stats reports.
LLM_USAGE_RETENTION_DAYS=90
# true logs prompts and answers in full, which carries what users typed. Local
# debugging only; never in production.
LLM_LOG_CONTENT=false
