#, python-brace-format
msgid "Active in the last day / week / month: {day} / {week} / {month}"
msgstr "Активны за день / неделю / месяц: {day} / {week} / {month}"

msgid "Admins and developers cannot be banned."
msgstr "Админов и разработчиков банить нельзя."

msgid "Ban a user"
msgstr "Забанить пользователя"

#, python-brace-format
msgid "Banned: {count}"
msgstr "Забанены: {count}"

msgid "Change language"
msgstr "Сменить язык"

msgid "Choose your language:"
msgstr "Выберите язык:"

msgid "Commands:"
msgstr "Команды:"

#, python-brace-format
msgid ""
"Hello, {name}!\n"
"\n"
"Send /help to see what I can do."
msgstr ""
"Привет, {name}!\n"
"\n"
"Отправьте /help, чтобы узнать, что я умею."

#, python-brace-format
msgid "Language: {language}"
msgstr "Язык: {language}"

#, python-brace-format
msgid "New in the last day / week / month: {day} / {week} / {month}"
msgstr "Новые за день / неделю / месяц: {day} / {week} / {month}"

msgid "No such user. They have to start the bot first."
msgstr "Такого пользователя нет. Сначала он должен запустить бота."

#, python-brace-format
msgid "Reachable: {count}"
msgstr "Достижимы: {count}"

#, python-brace-format
msgid "Several users have had @{username}. Use the numeric id instead."
msgstr "@{username} был у нескольких пользователей. Укажите числовой id."

msgid "Show help"
msgstr "Показать справку"

msgid "Show user statistics"
msgstr "Статистика пользователей"

msgid "Something went wrong. Please try again later."
msgstr "Что-то пошло не так. Попробуйте ещё раз чуть позже."

msgid "Start the bot"
msgstr "Запустить бота"

msgid "This language is not available."
msgstr "Этот язык недоступен."

#, python-brace-format
msgid "Too many requests. Try again in {seconds} second."
msgid_plural "Too many requests. Try again in {seconds} seconds."
msgstr[0] "Слишком много запросов. Попробуйте через {seconds} секунду."
msgstr[1] "Слишком много запросов. Попробуйте через {seconds} секунды."
msgstr[2] "Слишком много запросов. Попробуйте через {seconds} секунд."

msgid "Unban a user"
msgstr "Разбанить пользователя"

#, python-brace-format
msgid "Usage: /{command} USER_ID or /{command} @username"
msgstr "Использование: /{command} ID или /{command} @username"

msgid "You cannot ban yourself."
msgstr "Себя забанить нельзя."

#, python-brace-format
msgid "{count} user"
msgid_plural "{count} users"
msgstr[0] "{count} пользователь"
msgstr[1] "{count} пользователя"
msgstr[2] "{count} пользователей"

#, python-brace-format
msgid "{name} ({id}) is already banned."
msgstr "{name} ({id}) уже забанен."

#, python-brace-format
msgid "{name} ({id}) is banned."
msgstr "{name} ({id}) забанен."

#, python-brace-format
msgid "{name} ({id}) is not banned."
msgstr "{name} ({id}) не забанен."

#, python-brace-format
msgid "{name} ({id}) is unbanned."
msgstr "{name} ({id}) разбанен."
