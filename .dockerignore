**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.Python
# Every env file, whatever its suffix: the image runs `COPY . .`, so a local
# .env.prod or .env.backup would otherwise ship its secrets in a layer. The bot
# reads its settings from the container environment, never from a file here.
.env*
.venv
**/*.log
logs/
backups/
.git

# Runtime code only: tests run on the host, so keep dev tooling, tests, docs,
# and caches out of the image.
.idea/
.vscode/
docs/
docs-local/
tests/
.mypy_cache/
.ruff_cache/
.pytest_cache/
coverage.xml
.coverage
htmlcov/

# Compiled catalogs come from the image's own build stage, never from a
# developer's tree.
**/*.mo
