PROJECT_NAME="Telegram bot test"
VERSION=0.0.0
DEBUG=false
TESTING=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Bot
BOT_TOKEN=123456789:AAtest-bot-token-not-real-0000000000000
BOT_MODE=polling
DEFAULT_LOCALE=en
USER_TOUCH_INTERVAL_SECONDS=300
TELEGRAM_RETRY_ATTEMPTS=3
SHUTDOWN_TIMEOUT_SECONDS=20
ADMIN_IDS=
DEVELOPER_IDS=
DEV_ALERT_CHAT_ID=
ALERT_COOLDOWN_SECONDS=300

# Web server
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8080

# Webhook. Left empty on purpose: tests that need webhook mode pass their own
# values, and a test relying on an empty secret must find it empty here.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=
WEBHOOK_MAX_CONNECTIONS=40

# PostgreSQL (make test-integration overrides host and port)
DB_ECHO=0
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_STATEMENT_TIMEOUT_SECONDS=30
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_FSM_DATABASE=2
REDIS_TASKS_DATABASE=1

# Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60
CACHE_VERSION_TTL=604800
CACHE_KEY_PREFIX=cache

# Sentry disabled in tests
SENTRY_DSN=
SENTRY_ENV=test
SENTRY_ENABLED=false

HTTP_USER_AGENT=

# LLM off: tests that need a provider build their own LLMConfig.
LLM_PROVIDER=
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_PRICING_OVERRIDES=
LLM_USAGE_RETENTION_DAYS=90
LLM_LOG_CONTENT=false
